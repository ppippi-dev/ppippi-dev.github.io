---
import { SITE_TITLE } from '../consts';

interface Props {
	slug?: string;
}

const { slug } = Astro.props;
const koLink = slug ? `/blog/${slug}/` : '/';
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const brand = SITE_TITLE.replace('-dev Blog', '.dev');
const navigation = [
	{ href: '/en/', label: 'Posts', active: pathname === '/en/' || pathname.startsWith('/en/blog/') },
	{ href: '/tags/', label: 'Topics · KO', active: pathname.startsWith('/tags/') || pathname.startsWith('/en/tags/'), hreflang: 'ko' },
	{ href: '/search/', label: 'Search · KO', active: pathname === '/search/', hreflang: 'ko' },
	{ href: '/contact/', label: 'About · KO', active: pathname === '/contact/', hreflang: 'ko' },
];
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
	<nav class="site-nav" aria-label="Primary navigation">
		<a href="/en/" class="brand" aria-label={`${SITE_TITLE} English home`}>
			<span class="brand-mark" aria-hidden="true"></span>
			<span>{brand}</span>
		</a>

		<div class="primary-navigation">
			{navigation.map((item) => (
				<a
					href={item.href}
					hreflang={item.hreflang}
					class:list={['primary-link', { active: item.active }]}
					aria-current={pathname === item.href ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}
		</div>

		<div class="nav-utilities">
			<a href={koLink} hreflang="ko" class="utility-link locale-link" aria-label="한국어 페이지로 이동">KO</a>
			<a
				href="https://github.com/ppippi-dev"
				target="_blank"
				rel="noopener noreferrer"
				class="utility-link icon-link"
				aria-label="Open GitHub profile in a new tab"
			>
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
				</svg>
			</a>
			<button
				id="theme-toggle"
				type="button"
				class="theme-toggle"
				aria-label="Dark theme"
				aria-pressed="false"
				data-light-label="Switch to dark theme"
				data-dark-label="Switch to light theme"
			>
				<svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
					<circle cx="12" cy="12" r="4.5"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
				</svg>
				<svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
					<path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<style>
	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 1000;
		padding: 0.65rem 0.9rem;
		background: var(--text-primary);
		color: var(--bg-primary);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-decoration: none;
		transform: translateY(calc(-100% - 1rem));
		transition: transform var(--transition-fast);
	}

	.skip-link:focus-visible {
		color: var(--bg-primary);
		transform: translateY(0);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border-color);
		background: rgba(243, 240, 231, 0.94);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition: background-color var(--transition-normal), border-color var(--transition-normal);
	}

	:global([data-theme='dark']) .site-header {
		background: rgba(23, 24, 20, 0.94);
	}

	.site-nav {
		display: grid;
		grid-template-columns: minmax(10rem, 1fr) auto minmax(10rem, 1fr);
		align-items: center;
		width: 100%;
		max-width: var(--site-max-width);
		height: 4.5rem;
		margin: 0 auto;
		padding: 0 clamp(1.25rem, 4vw, 3.5rem);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		gap: 0.75rem;
		min-width: 0;
		color: var(--text-primary);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 650;
		letter-spacing: 0.045em;
		text-decoration: none;
		white-space: nowrap;
	}

	.brand:hover {
		color: var(--text-primary);
		text-decoration: none;
	}

	.brand-mark {
		width: 0.65rem;
		height: 0.65rem;
		border: 1px solid color-mix(in srgb, var(--accent-primary) 72%, var(--text-primary));
		border-radius: 50%;
		background: var(--accent-primary);
		box-shadow: inset 0.16rem 0.12rem 0 rgba(255, 255, 255, 0.28);
		flex: 0 0 auto;
	}

	.primary-navigation,
	.nav-utilities {
		display: flex;
		align-items: stretch;
	}

	.primary-navigation {
		justify-content: center;
		gap: clamp(1.5rem, 4vw, 3.75rem);
		height: 100%;
	}

	.primary-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		color: var(--text-secondary);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: color var(--transition-fast);
	}

	.primary-link::after {
		position: absolute;
		bottom: -1px;
		left: 50%;
		width: 0;
		height: 2px;
		background: var(--accent-primary);
		content: '';
		transform: translateX(-50%);
		transition: width var(--transition-fast);
	}

	.primary-link:hover,
	.primary-link.active {
		color: var(--text-primary);
		text-decoration: none;
	}

	.primary-link:hover::after,
	.primary-link.active::after {
		width: 100%;
	}

	.nav-utilities {
		justify-self: end;
		align-items: center;
		gap: 0.25rem;
		padding-left: clamp(0.75rem, 2vw, 1.5rem);
		border-left: 1px solid var(--border-color);
	}

	.utility-link,
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--text-primary);
		text-decoration: none;
		transition: border-color var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
	}

	.locale-link {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 650;
		letter-spacing: 0.08em;
	}

	.icon-link svg,
	.theme-toggle svg {
		display: block;
	}

	.utility-link:hover,
	.theme-toggle:hover {
		border-color: var(--border-color);
		background: var(--bg-secondary);
		color: var(--text-primary);
		text-decoration: none;
	}

	.utility-link:active,
	.theme-toggle:active {
		transform: translateY(1px);
	}

	.theme-toggle {
		font: inherit;
		cursor: pointer;
	}

	.sun-icon {
		display: none !important;
	}

	.moon-icon {
		display: block !important;
	}

	:global([data-theme='dark']) .sun-icon {
		display: block !important;
	}

	:global([data-theme='dark']) .moon-icon {
		display: none !important;
	}

	@media (max-width: 760px) {
		.site-nav {
			grid-template-columns: minmax(0, 1fr) auto;
			height: auto;
			padding: 0.7rem 1.25rem 0;
		}

		.brand {
			font-size: 0.8125rem;
		}

		.nav-utilities {
			grid-column: 2;
			padding-left: 0.6rem;
		}

		.primary-navigation {
			grid-column: 1 / -1;
			grid-row: 2;
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			width: 100%;
			height: 2.9rem;
			margin-top: 0.6rem;
			gap: 0;
			border-top: 1px solid var(--border-color);
		}

		.primary-link {
			justify-content: center;
			font-size: 0.78rem;
		}
	}

	@media (max-width: 420px) {
		.site-nav {
			padding-inline: 0.8rem;
		}

		.brand {
			gap: 0.5rem;
			font-size: 0.75rem;
		}

		.brand-mark {
			width: 0.55rem;
			height: 0.55rem;
		}

		.nav-utilities {
			gap: 0;
			padding-left: 0.4rem;
		}

		.utility-link,
		.theme-toggle {
			width: 2rem;
			height: 2rem;
		}

		.primary-link {
			font-size: 0.72rem;
		}
	}
</style>

<script>
	function initHeader() {
		const main = document.querySelector('main');
		if (main) {
			if (!main.id) main.id = 'main-content';
			if (!main.hasAttribute('tabindex')) main.setAttribute('tabindex', '-1');
		}

		const toggle = document.getElementById('theme-toggle');
		if (!(toggle instanceof HTMLButtonElement)) return;

		const syncToggle = () => {
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			const label = isDark ? toggle.dataset.darkLabel : toggle.dataset.lightLabel;
			toggle.setAttribute('aria-pressed', String(isDark));
			if (label) toggle.title = label;
		};

		syncToggle();
		if (toggle.dataset.themeBound === 'true') return;
		toggle.dataset.themeBound = 'true';
		toggle.addEventListener('click', () => {
			const current = document.documentElement.getAttribute('data-theme');
			const next = current === 'dark' ? 'light' : 'dark';
			document.documentElement.setAttribute('data-theme', next);
			localStorage.setItem('theme', next);
			syncToggle();
		});
	}

	initHeader();
	document.addEventListener('astro:after-swap', initHeader);
</script>
