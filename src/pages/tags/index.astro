---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const tagCounts = new Map<string, number>();

for (const post of posts) {
	for (const tag of post.data.tags || []) {
		tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
	}
}

const tags = [...tagCounts.entries()].sort(([a], [b]) => a.localeCompare(b, 'ko'));
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`주제 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				box-sizing: border-box;
				width: 100%;
				max-width: 1120px;
				min-height: 70vh;
				margin: 0 auto;
				padding: clamp(3.5rem, 8vw, 7rem) clamp(1.25rem, 5vw, 3rem) clamp(5rem, 10vw, 8rem);
			}

			.page-header {
				display: grid;
				grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
				gap: clamp(2rem, 6vw, 6rem);
				align-items: end;
				padding-bottom: clamp(2rem, 5vw, 3.5rem);
				border-bottom: 1px solid var(--border-color);
			}

			.eyebrow,
			.section-label,
			.tag-index,
			.tag-count,
			.tag-arrow {
				font-family: 'SF Mono', Menlo, Consolas, monospace;
			}

			.eyebrow,
			.section-label {
				font-size: 0.75rem;
				font-weight: 600;
				line-height: 1.4;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.eyebrow {
				margin: 0 0 1.25rem;
				color: var(--accent-primary);
			}

			h1 {
				max-width: 8ch;
				font-size: clamp(3rem, 8vw, 6.5rem);
				font-weight: 800;
				line-height: 0.92;
				letter-spacing: -0.065em;
				text-wrap: balance;
			}

			.lede {
				max-width: 34rem;
				margin: 0;
				color: var(--text-secondary);
				font-size: clamp(1rem, 2vw, 1.125rem);
				line-height: 1.75;
			}

			.tags-section {
				padding-top: clamp(2.5rem, 7vw, 5rem);
			}

			.section-heading {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				align-items: baseline;
				margin-bottom: 1.25rem;
			}

			.section-label {
				margin: 0;
				color: var(--text-secondary);
			}

			.total-count {
				color: var(--text-secondary);
				font-family: 'SF Mono', Menlo, Consolas, monospace;
				font-size: 0.75rem;
			}

			.tag-list {
				margin: 0;
				padding: 0;
				border-top: 1px solid var(--border-color);
				list-style: none;
			}

			.tag-link {
				display: grid;
				grid-template-columns: 3.5rem minmax(0, 1fr) auto 2.5rem;
				gap: clamp(0.75rem, 3vw, 2rem);
				align-items: center;
				min-height: 5.75rem;
				border-bottom: 1px solid var(--border-color);
				color: var(--text-primary);
				text-decoration: none;
				transition: color var(--transition-fast), background-color var(--transition-fast);
			}

			.tag-link:hover {
				background: var(--bg-secondary);
				color: var(--accent-primary);
				text-decoration: none;
			}

			.tag-index {
				color: var(--accent-primary);
				font-size: 0.75rem;
			}

			.tag-name {
				min-width: 0;
				font-size: clamp(1.35rem, 3vw, 2rem);
				font-weight: 700;
				line-height: 1.15;
				letter-spacing: -0.035em;
				overflow-wrap: anywhere;
			}

			.tag-count {
				color: var(--text-secondary);
				font-size: 0.75rem;
				white-space: nowrap;
			}

			.tag-arrow {
				display: grid;
				width: 2rem;
				height: 2rem;
				place-items: center;
				border: 1px solid var(--border-color);
				border-radius: 50%;
				color: var(--accent-primary);
			}

			.empty-state {
				padding: clamp(2rem, 6vw, 4rem);
				border: 1px solid var(--border-color);
				text-align: center;
			}

			.empty-state h2 {
				margin: 0 0 0.75rem;
				font-size: 1.5rem;
			}

			.empty-state p {
				margin: 0;
				color: var(--text-secondary);
			}

			@media (max-width: 720px) {
				.page-header {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}

				h1 {
					font-size: clamp(2.75rem, 16vw, 4.5rem);
				}

				.tag-link {
					grid-template-columns: 2rem minmax(0, 1fr) auto;
					gap: 0.75rem;
					min-height: 5rem;
				}

				.tag-count {
					grid-column: 2;
					grid-row: 2;
				}

				.tag-arrow {
					grid-column: 3;
					grid-row: 1 / span 2;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="page-header">
				<div>
					<p class="eyebrow">Index / Topics</p>
					<h1>관심사를 따라 읽습니다.</h1>
				</div>
				<p class="lede">AI, MLOps, Kubernetes, Cloud를 중심으로 쌓아 온 기록을 주제별로 모았습니다.</p>
			</header>

			<section class="tags-section" aria-labelledby="topic-index">
				<div class="section-heading">
					<h2 id="topic-index" class="section-label">Topic index</h2>
					<span class="total-count">{tags.length} TOPICS</span>
				</div>

				{tags.length > 0 ? (
					<ul class="tag-list">
						{tags.map(([tag, count], index) => (
							<li>
								<a href={`/tags/${encodeURIComponent(tag)}/`} class="tag-link">
									<span class="tag-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<span class="tag-name">{tag}</span>
									<span class="tag-count">{count} POSTS</span>
									<span class="tag-arrow" aria-hidden="true">→</span>
								</a>
							</li>
						))}
					</ul>
				) : (
					<div class="empty-state" role="status">
						<h2>아직 등록된 주제가 없습니다.</h2>
						<p>새 글이 발행되면 이곳에서 주제별로 살펴볼 수 있습니다.</p>
					</div>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
