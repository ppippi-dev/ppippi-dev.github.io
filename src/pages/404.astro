---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`404 - ${SITE_TITLE}`} description="페이지를 찾을 수 없습니다." />
		<script is:inline>
			(function() {
				const path = window.location.pathname;

				// 옛 URL 패턴: /YYYY/MM/DD/slug/ → /blog/slug/
				const koMatch = path.match(/^\/(\d{4})\/(\d{2})\/(\d{2})\/(.+?)\/?$/);
				if (koMatch) {
					const slug = koMatch[4];
					window.location.replace('/blog/' + slug + '/');
					return;
				}

				// 옛 URL 패턴: /en/YYYY/MM/DD/slug/ → /en/blog/slug/
				const enMatch = path.match(/^\/en\/(\d{4})\/(\d{2})\/(\d{2})\/(.+?)\/?$/);
				if (enMatch) {
					const slug = enMatch[4];
					window.location.replace('/en/blog/' + slug + '/');
					return;
				}

				if (typeof gtag === 'function') {
					gtag('event', '404_error', {
						page_path: path,
						page_referrer: document.referrer || '(direct)'
					});
				}
			})();
		</script>
		<style>
			main {
				box-sizing: border-box;
				display: grid;
				width: 100%;
				max-width: 1120px;
				min-height: 72vh;
				margin: 0 auto;
				padding: clamp(3.5rem, 8vw, 7rem) clamp(1.25rem, 5vw, 3rem) clamp(5rem, 10vw, 8rem);
			}

			.error-shell {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.65fr);
				gap: clamp(2rem, 7vw, 7rem);
				align-items: end;
				padding: clamp(2rem, 6vw, 5rem) 0;
				border-top: 1px solid var(--border-color);
				border-bottom: 1px solid var(--border-color);
			}

			.eyebrow,
			.error-code,
			.action-link {
				font-family: 'SF Mono', Menlo, Consolas, monospace;
			}

			.eyebrow {
				margin: 0 0 1.25rem;
				color: var(--accent-primary);
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			h1 {
				max-width: 10ch;
				font-size: clamp(3rem, 8vw, 6.5rem);
				font-weight: 800;
				line-height: 0.92;
				letter-spacing: -0.065em;
				text-wrap: balance;
			}

			.error-code {
				align-self: start;
				color: var(--accent-primary);
				font-size: clamp(6rem, 20vw, 13rem);
				font-weight: 700;
				line-height: 0.72;
				letter-spacing: -0.1em;
				text-align: right;
			}

			.error-detail {
				grid-column: 1 / -1;
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 2rem;
				align-items: center;
				padding-top: clamp(1rem, 3vw, 2rem);
				border-top: 1px solid var(--border-color);
			}

			.error-detail p {
				max-width: 42rem;
				margin: 0;
				color: var(--text-secondary);
				font-size: 1.0625rem;
			}

			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem;
			}

			.action-link {
				display: inline-flex;
				align-items: center;
				min-height: 44px;
				color: var(--accent-primary);
				font-size: 0.8rem;
				font-weight: 600;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.45rem;
			}

			.action-link:hover {
				color: var(--accent-hover);
			}

			@media (max-width: 720px) {
				.error-shell,
				.error-detail {
					grid-template-columns: 1fr;
				}

				h1 {
					font-size: clamp(2.75rem, 16vw, 4.5rem);
				}

				.error-code {
					font-size: clamp(5rem, 30vw, 8rem);
					text-align: left;
				}

				.actions {
					gap: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="error-shell" aria-labelledby="error-title">
				<div>
					<p class="eyebrow">Error / Not found</p>
					<h1 id="error-title">페이지를 찾을 수 없습니다.</h1>
				</div>
				<div class="error-code" aria-hidden="true">404</div>
				<div class="error-detail">
					<p>주소가 바뀌었거나 페이지가 삭제되었을 수 있습니다. 검색하거나 최근 기록으로 돌아가 보세요.</p>
					<nav class="actions" aria-label="오류 페이지 이동">
						<a class="action-link" href="/">최근 글 보기&nbsp;→</a>
						<a class="action-link" href="/search/">검색하기&nbsp;→</a>
					</nav>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
