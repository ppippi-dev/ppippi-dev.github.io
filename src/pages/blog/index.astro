---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`모든 글 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				box-sizing: border-box;
				width: 100%;
				max-width: 1120px;
				min-height: 70vh;
				margin: 0 auto;
				padding: clamp(3.5rem, 8vw, 7rem) clamp(1.25rem, 5vw, 3rem) clamp(5rem, 10vw, 8rem);
			}

			.page-header {
				display: grid;
				grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
				gap: clamp(2rem, 6vw, 6rem);
				align-items: end;
				padding-bottom: clamp(2rem, 5vw, 3.5rem);
				border-bottom: 1px solid var(--border-color);
			}

			.eyebrow,
			.section-label,
			.post-index,
			.post-meta,
			.post-tag {
				font-family: 'SF Mono', Menlo, Consolas, monospace;
			}

			.eyebrow,
			.section-label {
				font-size: 0.75rem;
				font-weight: 600;
				line-height: 1.4;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.eyebrow {
				margin: 0 0 1.25rem;
				color: var(--accent-primary);
			}

			h1 {
				max-width: 9ch;
				font-size: clamp(3rem, 8vw, 6.5rem);
				font-weight: 800;
				line-height: 0.92;
				letter-spacing: -0.065em;
				text-wrap: balance;
			}

			.lede {
				max-width: 34rem;
				margin: 0;
				color: var(--text-secondary);
				font-size: clamp(1rem, 2vw, 1.125rem);
				line-height: 1.75;
			}

			.posts-section {
				padding-top: clamp(2.5rem, 7vw, 5rem);
			}

			.section-heading {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				align-items: baseline;
				margin-bottom: 1.25rem;
			}

			.section-label {
				margin: 0;
				color: var(--text-secondary);
			}

			.total-count {
				color: var(--text-secondary);
				font-family: 'SF Mono', Menlo, Consolas, monospace;
				font-size: 0.75rem;
			}

			.post-list {
				margin: 0;
				padding: 0;
				border-top: 1px solid var(--border-color);
				list-style: none;
			}

			.post-item {
				display: grid;
				grid-template-columns: 3.5rem minmax(0, 1fr) minmax(9rem, auto);
				gap: clamp(1rem, 4vw, 3rem);
				align-items: start;
				padding: clamp(1.5rem, 4vw, 2.75rem) 0;
				border-bottom: 1px solid var(--border-color);
			}

			.post-index {
				padding-top: 0.25rem;
				color: var(--accent-primary);
				font-size: 0.75rem;
			}

			.post-copy {
				min-width: 0;
			}

			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 0.8rem;
				margin-bottom: 0.8rem;
			}

			.post-tag {
				color: var(--accent-primary);
				font-size: 0.7rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}

			.post-tag:hover {
				color: var(--accent-hover);
				text-decoration: underline;
				text-underline-offset: 0.25rem;
			}

			.post-title {
				margin: 0;
				font-size: clamp(1.35rem, 3vw, 2rem);
				font-weight: 700;
				line-height: 1.2;
				letter-spacing: -0.035em;
			}

			.post-title a {
				color: var(--text-primary);
				text-decoration: none;
				overflow-wrap: anywhere;
			}

			.post-title a:hover {
				color: var(--accent-primary);
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 0.35rem;
			}

			.post-description {
				max-width: 50rem;
				margin: 0.75rem 0 0;
				color: var(--text-secondary);
				line-height: 1.65;
				text-wrap: pretty;
			}

			.post-meta {
				justify-self: end;
				padding-top: 0.35rem;
				color: var(--text-secondary);
				font-size: 0.75rem;
				font-variant-numeric: tabular-nums;
				white-space: nowrap;
			}

			.empty-state {
				padding: clamp(2rem, 6vw, 4rem);
				border: 1px solid var(--border-color);
				text-align: center;
			}

			.empty-state h2 {
				margin: 0 0 0.75rem;
				font-size: 1.5rem;
			}

			.empty-state p {
				margin: 0;
				color: var(--text-secondary);
			}

			@media (max-width: 720px) {
				.page-header {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}

				h1 {
					font-size: clamp(2.75rem, 16vw, 4.5rem);
				}

				.post-item {
					grid-template-columns: 2rem minmax(0, 1fr);
					gap: 0.75rem;
				}

				.post-meta {
					grid-column: 2;
					grid-row: 1;
					justify-self: start;
					padding-top: 0;
				}

				.post-copy {
					grid-column: 2;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<header class="page-header">
				<div>
					<p class="eyebrow">Archive / All notes</p>
					<h1>모든 기록을 한곳에.</h1>
				</div>
				<p class="lede">운영과 개발 과정에서 마주한 문제, 실험, 해결 과정을 최신순으로 모았습니다.</p>
			</header>

			<section class="posts-section" aria-labelledby="all-posts">
				<div class="section-heading">
					<h2 id="all-posts" class="section-label">Complete archive</h2>
					<span class="total-count">{posts.length} POSTS</span>
				</div>

				{posts.length > 0 ? (
					<ol class="post-list">
						{posts.map((post, index) => (
							<li>
								<article class="post-item">
									<span class="post-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
									<div class="post-copy">
										{post.data.tags && post.data.tags.length > 0 && (
											<div class="post-tags">
												{post.data.tags.slice(0, 3).map((tag) => (
													<a class="post-tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
												))}
											</div>
										)}
										<h2 class="post-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
										{post.data.description && <p class="post-description">{post.data.description}</p>}
									</div>
									<div class="post-meta"><FormattedDate date={post.data.pubDate} /></div>
								</article>
							</li>
						))}
					</ol>
				) : (
					<div class="empty-state" role="status">
						<h2>아직 공개된 글이 없습니다.</h2>
						<p>새 기록을 준비하고 있습니다. 잠시 후 다시 확인해 주세요.</p>
					</div>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
