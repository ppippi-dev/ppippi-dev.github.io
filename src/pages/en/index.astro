---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import HeaderEn from '../../components/HeaderEn.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog-en')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts.find((post) => post.id === 'dify') ?? posts[0];
const recentPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 6);

const normalizeTag = (tag: string) => tag.trim().toLowerCase();
const countPostsForTags = (tags: readonly string[]) => {
	const matchingTags = new Set(tags.map(normalizeTag));
	const matchingPostIds = new Set<string>();

	for (const post of posts) {
		if ((post.data.tags ?? []).some((tag) => matchingTags.has(normalizeTag(tag)))) {
			matchingPostIds.add(post.id);
		}
	}

	return matchingPostIds.size;
};

const focusTracks = [
	{
		number: '01',
		name: 'AI · LLMOps',
		description: 'Agents, prompts, RAG, evaluation, and observability',
		tags: ['llmops', 'llm', 'agent', 'agno', 'mcp', 'rag', 'dify', 'nocode', 'no-code', 'workflow', 'automation', 'opensource', 'self-hosted'],
		links: ['LLMOps', 'Agent', 'MCP'],
	},
	{
		number: '02',
		name: 'Kubernetes · MLOps',
		description: 'Kubernetes operations, delivery pipelines, GPUs, and model serving',
		tags: ['kubernetes', 'mlops', 'gke', 'gpu', 'nvidia', 'keda', 'argocd', 'github action', 'devops', 'infra'],
		links: ['kubernetes', 'MLOps', 'GKE'],
	},
	{
		number: '03',
		name: 'Cloud · Data',
		description: 'Cloud architecture, data pipelines, storage, and databases',
		tags: ['gcp', 'aws', 'terraform', 'python', 'datacamp', 'spark', 'pandas', 'db', 'sql', 'mongodb', 'bigquery', 'dbt', 'airflow', 'boto3', 'shell', 'bash', 'secret-manager', 'workload identity'],
		links: ['GCP', 'AWS', 'Terraform'],
	},
].map((track) => ({ ...track, count: countPostsForTags(track.tags) }));

const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))].sort(
	(a, b) => b - a,
);
const archive = years.map((year) => ({
	year,
	posts: posts.filter((post) => post.data.pubDate.getFullYear() === year),
}));

const recentMedia: Record<string, { src: string; alt: string }> = {
	sim: {
		src: '/img/sim/image-20260103225328920.webp',
		alt: 'A stock analysis workflow generated from natural language in sim',
	},
	'mcp-context-forge': {
		src: '/img/mcp-context-forge/image-20251219001059140.webp',
		alt: 'The MCP Gateway administration screen in mcp-context-forge',
	},
};

const homeDescription = SITE_DESCRIPTION;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={homeDescription} />
		<style>
			:root {
				--home-max: 76rem;
				--home-gutter: clamp(1.25rem, 4vw, 3rem);
				--home-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
			}

			.home-main {
				position: relative;
				width: 100%;
				overflow: clip;
			}

			.home-main::before {
				position: absolute;
				inset-block: 0;
				left: 50%;
				width: min(calc(100% - (var(--home-gutter) * 2)), var(--home-max));
				background-image: linear-gradient(to right, transparent calc(100% - 1px), var(--border-color) 1px);
				background-size: calc(100% / 12) 100%;
				content: '';
				opacity: 0.35;
				pointer-events: none;
				transform: translateX(-50%);
			}

			.home-section {
				position: relative;
				width: min(calc(100% - (var(--home-gutter) * 2)), var(--home-max));
				margin-inline: auto;
			}

			.eyebrow,
			.section-kicker,
			.track-number,
			.post-taxonomy,
			.metric-label,
			.archive-count,
			.profile-meta,
			.recent-number {
				font-family: var(--home-mono);
				font-variant-numeric: tabular-nums;
			}

			.eyebrow,
			.section-kicker,
			.track-number,
			.post-taxonomy,
			.recent-number {
				color: var(--accent-primary);
				font-size: 0.72rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}

			.hero {
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: clamp(1.5rem, 3vw, 2.5rem);
				align-items: center;
				padding-block: clamp(5.5rem, 12vw, 10rem) clamp(7rem, 13vw, 11rem);
			}

			.hero-copy {
				grid-column: 1 / span 7;
				min-width: 0;
			}

			.eyebrow {
				margin: 0 0 clamp(1.6rem, 3vw, 2.5rem);
			}

			.hero-title {
				max-width: 9ch;
				margin: 0;
				font-size: clamp(3.15rem, 7vw, 6.8rem);
				font-weight: 800;
				letter-spacing: -0.075em;
				line-height: 0.98;
				text-wrap: balance;
			}

			.hero-description {
				max-width: 38rem;
				margin: clamp(1.8rem, 4vw, 3rem) 0 0;
				color: var(--text-secondary);
				font-size: clamp(1rem, 1.5vw, 1.2rem);
				line-height: 1.75;
				text-wrap: pretty;
			}

			.text-link {
				display: inline-flex;
				align-items: center;
				gap: 0.7rem;
				margin-top: 2rem;
				padding-bottom: 0.4rem;
				border-bottom: 1px solid currentColor;
				font-size: 0.9rem;
				font-weight: 600;
				text-decoration: none;
			}

			.text-link:hover {
				text-decoration: none;
			}

			.text-link span {
				transition: transform var(--transition-normal);
			}

			.text-link:hover span {
				transform: translateX(0.25rem);
			}

			.profile-frame {
				display: flex;
				grid-column: 9 / -1;
				flex-direction: column;
				justify-self: end;
				width: min(100%, 22rem);
				aspect-ratio: 4 / 5;
				margin: 0;
				padding: 0.75rem;
				border: 1px solid var(--border-hover);
				background: var(--bg-primary);
			}

			.profile-image {
				min-height: 0;
				flex: 1;
				overflow: hidden;
				background: var(--bg-secondary);
			}

			.profile-image img {
				display: block;
				width: 100%;
				height: 100%;
				border-radius: 0;
				object-fit: cover;
				transition: transform 500ms ease;
			}

			.profile-frame:hover img {
				transform: scale(1.025);
			}

			.profile-caption {
				display: grid;
				gap: 0.1rem;
				padding: 1rem 0.25rem 0.15rem;
			}

			.profile-name {
				font-family: var(--home-mono);
				font-size: 0.9rem;
				font-weight: 700;
				letter-spacing: 0.04em;
			}

			.profile-meta {
				color: var(--text-secondary);
				font-size: 0.68rem;
				line-height: 1.5;
			}

			.section-rule {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}

			.section-rule::before {
				width: 1px;
				height: 1.5rem;
				background: var(--text-muted);
				content: '';
			}

			.section-rule::after {
				width: 2.5rem;
				height: 1px;
				background: var(--border-hover);
				content: '';
			}

			.section-kicker {
				margin: 0;
			}

			.featured {
				padding-bottom: clamp(7rem, 12vw, 10rem);
			}

			.featured-card {
				border: 1px solid var(--border-hover);
				background: var(--bg-primary);
			}

			.featured-media {
				display: block;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				border-bottom: 1px solid var(--border-hover);
				background: var(--bg-secondary);
			}

			.featured-media img {
				display: block;
				width: 100%;
				height: 100%;
				border-radius: 0;
				object-fit: cover;
				transition: transform 500ms ease;
			}

			.featured-media:hover img {
				transform: scale(1.015);
			}

			.featured-body {
				display: grid;
				grid-template-columns: minmax(0, 7fr) minmax(16rem, 4fr);
				gap: clamp(2rem, 5vw, 5rem);
				padding: clamp(1.5rem, 4vw, 3rem);
			}

			.featured-title {
				max-width: 24ch;
				margin: 0;
				font-size: clamp(1.8rem, 3.6vw, 3.4rem);
				line-height: 1.12;
				text-wrap: balance;
			}

			.featured-title a,
			.recent-title a,
			.archive-post-link {
				color: var(--text-primary);
				text-decoration: none;
			}

			.featured-title a:hover,
			.recent-title a:hover,
			.archive-post-link:hover {
				color: var(--accent-primary);
				text-decoration: none;
			}

			.featured-meta,
			.recent-meta {
				color: var(--text-muted);
				font-family: var(--home-mono);
				font-size: 0.72rem;
				font-variant-numeric: tabular-nums;
			}

			.featured-meta {
				display: flex;
				gap: 0.75rem;
				align-items: center;
				margin-top: 1.5rem;
			}

			.featured-copy {
				align-self: end;
			}

			.featured-description {
				margin: 0;
				color: var(--text-secondary);
				font-size: 0.95rem;
				line-height: 1.75;
				text-wrap: pretty;
			}

			.focus {
				padding-bottom: clamp(7rem, 12vw, 10rem);
			}

			.section-intro {
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				gap: 1.5rem;
				align-items: end;
				margin-bottom: clamp(2.5rem, 5vw, 4rem);
			}

			.section-title {
				grid-column: 1 / span 7;
				margin: 0;
				font-size: clamp(2rem, 4vw, 3.5rem);
				line-height: 1.05;
			}

			.section-description {
				grid-column: 9 / -1;
				margin: 0;
				color: var(--text-secondary);
				font-size: 0.9rem;
				line-height: 1.7;
				text-wrap: pretty;
			}

			.focus-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				border-block: 1px solid var(--border-hover);
			}

			.focus-track {
				display: flex;
				min-width: 0;
				min-height: 18rem;
				flex-direction: column;
				padding: 2rem clamp(1.25rem, 3vw, 2.5rem) 1.75rem;
				border-right: 1px solid var(--border-hover);
			}

			.focus-track:last-child {
				border-right: 0;
			}

			.track-number {
				margin-bottom: 1.25rem;
			}

			.track-title {
				margin: 0;
				font-size: clamp(1.35rem, 2.4vw, 2rem);
				line-height: 1.18;
				text-wrap: balance;
			}

			.track-description {
				max-width: 26ch;
				margin: 0.8rem 0 0;
				color: var(--text-secondary);
				font-size: 0.86rem;
				line-height: 1.65;
			}

			.track-footer {
				display: flex;
				gap: 1rem;
				align-items: end;
				justify-content: space-between;
				margin-top: auto;
			}

			.track-count {
				margin: 0;
				color: var(--accent-primary);
				font: 700 clamp(2rem, 4vw, 3rem)/1 var(--home-mono);
			}

			.track-count span {
				display: block;
				margin-top: 0.35rem;
				color: var(--text-muted);
				font-size: 0.65rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.track-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 0.7rem;
				justify-content: flex-end;
			}

			.track-links a {
				color: var(--text-muted);
				font: 500 0.67rem/1.4 var(--home-mono);
				text-decoration: none;
			}

			.track-links a:hover {
				color: var(--accent-primary);
				text-decoration: none;
			}

			.recent {
				padding-bottom: clamp(5rem, 10vw, 8rem);
			}

			.recent-list {
				margin: 0;
				padding: 0;
				border-top: 1px solid var(--border-hover);
				list-style: none;
			}

			.recent-entry {
				display: grid;
				grid-template-columns: 3.5rem minmax(0, 5fr) minmax(10rem, 2.4fr) minmax(8rem, 1.5fr);
				gap: clamp(1rem, 3vw, 2.5rem);
				align-items: center;
				min-height: 10rem;
				padding-block: 1.5rem;
				border-bottom: 1px solid var(--border-hover);
			}

			.recent-number {
				align-self: stretch;
				padding-top: 0.25rem;
				border-right: 1px solid var(--border-color);
			}

			.recent-content {
				grid-column: 2;
				min-width: 0;
			}

			.post-taxonomy {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 0.65rem;
				margin: 0 0 0.7rem;
			}

			.post-taxonomy a {
				color: inherit;
				text-decoration: none;
			}

			.post-taxonomy a:hover {
				color: var(--accent-hover);
				text-decoration: none;
			}

			.recent-title {
				max-width: 29ch;
				margin: 0;
				font-size: clamp(1.25rem, 2.5vw, 2rem);
				line-height: 1.22;
				text-wrap: balance;
				overflow-wrap: anywhere;
			}

			.recent-media {
				display: block;
				grid-column: 3;
				aspect-ratio: 16 / 10;
				overflow: hidden;
				border: 1px solid var(--border-hover);
				background: var(--bg-secondary);
			}

			.recent-media img {
				display: block;
				width: 100%;
				height: 100%;
				border-radius: 0;
				object-fit: cover;
				transition: transform 400ms ease;
			}

			.recent-media:hover img {
				transform: scale(1.025);
			}

			.recent-meta {
				display: grid;
				grid-column: 4;
				gap: 0.75rem;
				justify-items: start;
			}

			.recent-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}

			.recent-tags a {
				padding: 0.2rem 0.45rem;
				border: 1px solid var(--border-hover);
				border-radius: 2px;
				color: var(--text-secondary);
				font-size: 0.65rem;
				text-decoration: none;
			}

			.recent-tags a:hover {
				border-color: var(--accent-primary);
				color: var(--accent-primary);
				text-decoration: none;
			}

			.metrics {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				margin: clamp(3rem, 6vw, 5rem) 0 0;
				border: 1px solid var(--border-hover);
			}

			.metric {
				display: flex;
				min-height: 10rem;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				border-right: 1px solid var(--border-hover);
			}

			.metric:last-child {
				border-right: 0;
			}

			.metric-label {
				order: 2;
				margin-top: 0.55rem;
				color: var(--text-secondary);
				font-size: 0.68rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
			}

			.metric-value {
				order: 1;
				margin: 0;
				font: 700 clamp(3rem, 7vw, 5.5rem)/0.9 var(--home-mono);
				letter-spacing: -0.08em;
			}

			.archive-section {
				padding-bottom: clamp(5rem, 10vw, 8rem);
			}

			.archive-list {
				border-top: 1px solid var(--border-hover);
			}

			.archive-year {
				border-bottom: 1px solid var(--border-hover);
			}

			.archive-year summary {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto 2.25rem;
				gap: 1rem;
				align-items: center;
				min-height: 4.5rem;
				padding-inline: 0.75rem;
				cursor: pointer;
				list-style: none;
				transition: background-color var(--transition-fast);
			}

			.archive-year summary::-webkit-details-marker {
				display: none;
			}

			.archive-year summary:hover {
				background: var(--bg-secondary);
			}

			.archive-year summary::after {
				display: grid;
				width: 1.8rem;
				height: 1.8rem;
				border: 1px solid var(--accent-primary);
				border-radius: 50%;
				color: var(--accent-primary);
				content: '↓';
				font: 500 0.85rem/1 var(--home-mono);
				place-items: center;
				transition: transform var(--transition-normal);
			}

			.archive-year[open] summary::after {
				transform: rotate(180deg);
			}

			.archive-year-label {
				font: 650 clamp(1.15rem, 2vw, 1.45rem)/1 var(--home-mono);
			}

			.archive-count {
				color: var(--text-muted);
				font-size: 0.68rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}

			.archive-posts {
				margin: 0;
				padding: 0 0 1.5rem 4.5rem;
				list-style: none;
			}

			.archive-post-link {
				display: grid;
				grid-template-columns: 7rem minmax(0, 1fr);
				gap: 1rem;
				align-items: baseline;
				padding: 0.65rem 0.75rem;
				border-top: 1px solid var(--border-color);
			}

			.archive-date {
				color: var(--text-muted);
				font: 500 0.68rem/1 var(--home-mono);
				font-variant-numeric: tabular-nums;
			}

			.archive-post-title {
				font-size: 0.95rem;
				font-weight: 550;
				line-height: 1.45;
				overflow-wrap: anywhere;
			}

			.author-band {
				display: grid;
				grid-template-columns: 8rem minmax(0, 1fr) minmax(12rem, 0.65fr);
				gap: clamp(1.5rem, 4vw, 3rem);
				align-items: center;
				margin-bottom: clamp(5rem, 9vw, 7rem);
				padding: clamp(1.25rem, 3vw, 2rem);
				border: 1px solid var(--border-hover);
				background: var(--bg-primary);
			}

			.author-avatar {
				aspect-ratio: 1;
				overflow: hidden;
				border: 1px solid var(--border-hover);
				border-radius: 50%;
			}

			.author-avatar img {
				display: block;
				width: 100%;
				height: 100%;
				border-radius: 0;
				object-fit: cover;
			}

			.author-title {
				margin: 0 0 0.5rem;
				font: 700 1.5rem/1.2 var(--home-mono);
				letter-spacing: -0.04em;
			}

			.author-copy {
				margin: 0;
				color: var(--text-secondary);
				font-size: 0.9rem;
			}

			.contact-links {
				display: grid;
				border-left: 1px solid var(--border-hover);
				padding-left: clamp(1.25rem, 3vw, 2.5rem);
			}

			.contact-links a {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.55rem 0;
				border-bottom: 1px solid var(--border-color);
				color: var(--text-primary);
				font: 500 0.78rem/1.4 var(--home-mono);
				text-decoration: none;
			}

			.contact-links a:hover {
				color: var(--accent-primary);
				text-decoration: none;
			}

			.empty-state {
				margin-bottom: 7rem;
				padding: clamp(3rem, 8vw, 6rem);
				border: 1px solid var(--border-hover);
				text-align: center;
			}

			.empty-state h2 {
				margin: 0 0 0.75rem;
			}

			.empty-state p {
				margin: 0;
				color: var(--text-secondary);
			}

			:global(body > header nav) {
				max-width: var(--home-max) !important;
				padding-inline: var(--home-gutter) !important;
			}

			:global(body > footer .footer-content) {
				max-width: var(--home-max) !important;
			}

			@media (max-width: 900px) {
				.hero-copy {
					grid-column: 1 / span 8;
				}

				.profile-frame {
					grid-column: 9 / -1;
				}

				.featured-body {
					grid-template-columns: minmax(0, 1fr);
				}

				.featured-copy {
					max-width: 42rem;
				}

				.recent-entry {
					grid-template-columns: 3rem minmax(0, 1fr) minmax(9rem, 0.38fr);
				}

				.recent-media {
					grid-column: 3;
				}

				.recent-meta {
					grid-column: 2;
					grid-row: 2;
				}
			}

			@media (max-width: 720px) {
				.home-main::before {
					background-size: 25% 100%;
				}

				.hero {
					grid-template-columns: minmax(0, 1fr);
					padding-block: 5.5rem 7rem;
				}

				.hero-copy,
				.profile-frame {
					grid-column: 1;
				}

				.hero-title {
					font-size: clamp(3.2rem, 16vw, 5.2rem);
				}

				.profile-frame {
					width: min(78vw, 21rem);
					margin-top: 2.5rem;
				}

				.section-title,
				.section-description {
					grid-column: 1 / -1;
				}

				.section-description {
					max-width: 34rem;
				}

				.focus-grid {
					grid-template-columns: minmax(0, 1fr);
				}

				.focus-track {
					min-height: 15rem;
					border-right: 0;
					border-bottom: 1px solid var(--border-hover);
				}

				.focus-track:last-child {
					border-bottom: 0;
				}

				.recent-entry {
					grid-template-columns: 2.75rem minmax(0, 1fr);
					gap: 1rem;
					align-items: start;
					padding-block: 1.75rem;
				}

				.recent-content,
				.recent-media,
				.recent-meta {
					grid-column: 2;
				}

				.recent-content {
					grid-row: 1;
				}

				.recent-media {
					grid-row: 2;
					margin-top: 0.5rem;
				}

				.recent-meta {
					grid-row: 3;
				}

				.metrics {
					grid-template-columns: minmax(0, 1fr);
				}

				.metric {
					min-height: 8rem;
					border-right: 0;
					border-bottom: 1px solid var(--border-hover);
				}

				.metric:last-child {
					border-bottom: 0;
				}

				.author-band {
					grid-template-columns: 5.5rem minmax(0, 1fr);
				}

				.contact-links {
					grid-column: 1 / -1;
					border-top: 1px solid var(--border-hover);
					border-left: 0;
					padding-top: 1rem;
					padding-left: 0;
				}
			}

			@media (max-width: 480px) {
				:root {
					--home-gutter: 1rem;
				}

				.hero-title {
					font-size: clamp(2.9rem, 15vw, 4.25rem);
				}

				.featured-body {
					padding: 1.25rem;
				}

				.featured-title {
					font-size: 1.7rem;
				}

				.archive-year summary {
					padding-inline: 0.25rem;
				}

				.archive-posts {
					padding-left: 0;
				}

				.archive-post-link {
					grid-template-columns: minmax(0, 1fr);
					gap: 0.35rem;
				}

				.author-band {
					grid-template-columns: minmax(0, 1fr);
				}

				.author-avatar {
					width: 5.5rem;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.profile-image img,
				.featured-media img,
				.recent-media img,
				.text-link span,
				.archive-year summary::after {
					transition: none;
				}
			}
		</style>
	</head>
	<body>
		<HeaderEn />
		<main id="main-content" class="home-main">
			<section class="home-section hero" aria-labelledby="home-title">
				<div class="hero-copy">
					<p class="eyebrow">FIELD NOTES / AI · INFRA · CLOUD</p>
					<h1 id="home-title" class="hero-title">Build it. Run it. Write it down.</h1>
					<p class="hero-description">Field notes on the decisions, tradeoffs, and failed attempts behind AI agents, MLOps, and cloud infrastructure.</p>
					<a class="text-link" href="#recent-notes">Read recent notes <span aria-hidden="true">→</span></a>
				</div>
				<figure class="profile-frame">
					<div class="profile-image">
						<img src="/img/avatar.webp" alt="The ppippi-dev dog character working at a laptop" width="888" height="863" loading="eager" fetchpriority="high" />
					</div>
					<figcaption class="profile-caption">
						<strong class="profile-name">ppippi</strong>
						<span class="profile-meta">Developer &amp; Builder<br />Seoul, KR</span>
					</figcaption>
				</figure>
			</section>

			{featuredPost ? (
				<>
					<section id="featured" class="home-section featured" aria-labelledby="featured-title">
						<div class="section-rule"><p class="section-kicker">FEATURED / 01</p></div>
						<article class="featured-card">
							<a class="featured-media" href={`/en/blog/${featuredPost.id}/`} aria-label={`Read ${featuredPost.data.title}`}>
								<img src="/img/dify/image-20260109230639695.webp" alt="Dify’s node-based AI workflow editor" width="2646" height="1896" loading="eager" />
							</a>
							<div class="featured-body">
								<div>
									<h2 id="featured-title" class="featured-title"><a href={`/en/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a></h2>
									<div class="featured-meta"><FormattedDate date={featuredPost.data.pubDate} /><span aria-hidden="true">·</span><span>{featuredPost.data.tags?.[0] ?? 'Field note'}</span></div>
								</div>
								<div class="featured-copy">
									<p class="featured-description">{featuredPost.data.description}</p>
									<a class="text-link" href={`/en/blog/${featuredPost.id}/`}>Read note <span aria-hidden="true">→</span></a>
								</div>
							</div>
						</article>
					</section>

					<section class="home-section focus" aria-labelledby="focus-title">
						<div class="section-rule"><p class="section-kicker">FOCUS TRACKS</p></div>
						<div class="section-intro">
							<h2 id="focus-title" class="section-title">Editorial focus</h2>
							<p class="section-description">Practical problems and the paths taken to solve them, organized by field.</p>
						</div>
						<div class="focus-grid">
							{focusTracks.map((track) => (
								<article class="focus-track">
									<span class="track-number">{track.number}</span>
									<h3 class="track-title">{track.name}</h3>
									<p class="track-description">{track.description}</p>
									<div class="track-footer">
										<p class="track-count">{track.count}<span>posts</span></p>
										<nav class="track-links" aria-label={`Key tags for ${track.name}`}>
											{track.links.map((tag) => <a href={`/en/tags/${tag}/`}>#{tag}</a>)}
										</nav>
									</div>
								</article>
							))}
						</div>
					</section>

					<section id="recent-notes" class="home-section recent" aria-labelledby="recent-title">
						<div class="section-rule"><p class="section-kicker">RECENT NOTES</p></div>
						<div class="section-intro">
							<h2 id="recent-title" class="section-title">Recent notes</h2>
							<p class="section-description">Problems found in development and operations, the experiments, and the path to an answer.</p>
						</div>
						<ol class="recent-list">
							{recentPosts.map((post, index) => {
								const media = recentMedia[post.id];
								return (
									<li>
										<article class="recent-entry">
											<span class="recent-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
											<div class="recent-content">
												<p class="post-taxonomy">
													{(post.data.tags ?? []).slice(0, 3).map((tag) => <a href={`/en/tags/${tag}/`}>{tag}</a>)}
												</p>
												<h3 class="recent-title"><a href={`/en/blog/${post.id}/`}>{post.data.title}</a></h3>
											</div>
											{media && (
												<a class="recent-media" href={`/en/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
													<img src={media.src} alt={media.alt} width="1200" height="750" loading="lazy" />
												</a>
											)}
											<div class="recent-meta">
												<FormattedDate date={post.data.pubDate} />
												<div class="recent-tags">
													{(post.data.tags ?? []).slice(0, 2).map((tag) => <a href={`/en/tags/${tag}/`}>{tag}</a>)}
												</div>
											</div>
										</article>
									</li>
								);
							})}
						</ol>

						<dl class="metrics" aria-label="Blog publishing overview">
							<div class="metric"><dt class="metric-label">posts</dt><dd class="metric-value">{posts.length}</dd></div>
							<div class="metric"><dt class="metric-label">years</dt><dd class="metric-value">{archive.length}</dd></div>
							<div class="metric"><dt class="metric-label">focus tracks</dt><dd class="metric-value">{focusTracks.length}</dd></div>
						</dl>
					</section>

					<section id="archive" class="home-section archive-section" aria-labelledby="archive-title">
						<div class="section-rule"><p class="section-kicker">ARCHIVE</p></div>
						<div class="section-intro">
							<h2 id="archive-title" class="section-title">Archive by year</h2>
							<p class="section-description">Browse every published note, grouped by year.</p>
						</div>
						<div class="archive-list">
							{archive.map((group, index) => (
								<details class="archive-year" open={index === 0}>
									<summary>
										<span class="archive-year-label">{group.year}</span>
										<span class="archive-count">{group.posts.length} posts</span>
									</summary>
									<ul class="archive-posts">
										{group.posts.map((post) => (
											<li>
												<a class="archive-post-link" href={`/en/blog/${post.id}/`}>
													<span class="archive-date"><FormattedDate date={post.data.pubDate} /></span>
													<span class="archive-post-title">{post.data.title}</span>
												</a>
											</li>
										))}
									</ul>
								</details>
							))}
						</div>
					</section>
				</>
			) : (
				<section class="home-section empty-state" aria-labelledby="empty-title">
					<h2 id="empty-title">No notes have been published yet.</h2>
					<p>The first field note is in progress.</p>
				</section>
			)}

			<section class="home-section author-band" aria-labelledby="author-title">
				<div class="author-avatar"><img src="/img/avatar.webp" alt="The ppippi-dev dog character" width="888" height="863" loading="lazy" /></div>
				<div>
					<h2 id="author-title" class="author-title">ppippi</h2>
					<p class="author-copy">Notes from building and operating real systems.</p>
				</div>
				<nav class="contact-links" aria-label="External profiles and contact">
					<a href="https://github.com/ppippi-dev" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
					<a href="https://www.linkedin.com/in/parkjeongbin/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
					<a href="/contact/" hreflang="ko">Contact · KO <span aria-hidden="true">→</span></a>
				</nav>
			</section>
		</main>
		<Footer />
	</body>
</html>
